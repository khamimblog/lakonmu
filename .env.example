# --- Database (Turso / libSQL) ---------------------------------------------
# Local dev: leave unset to use file:local.db
TURSO_DATABASE_URL=libsql://your-db-your-org.turso.io
TURSO_AUTH_TOKEN=

# --- Firebase (client, public) ---------------------------------------------
# Firebase console → Project settings → General → Your apps (Web)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (server, secret) ----------------------------------------
# Firebase console → Project settings → Service accounts → Generate new private key
FIREBASE_PROJECT_ID=your-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Keep the quotes and the literal \n sequences
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- AI (Phase 2+) ----------------------------------------------------------
GEMINI_API_KEY=

# --- Billing (Phase 5, off) -------------------------------------------------
NEXT_PUBLIC_BILLING_ENABLED=false

# --- Local only -------------------------------------------------------------
# Skip Google sign-in and use a fake "Dev User". Ignored in production.
AUTH_DEV_BYPASS=false
